# Docker deployment. Expose only to trusted ingress or a deliberate LAN address.
CONNECTMAP_IMAGE=sdex-connectmap:1.0.1
CONNECTMAP_BIND_ADDRESS=127.0.0.1
CONNECTMAP_HOST_PORT=8080

# Offline demonstration; set false and use onboarding for a real SDEX server.
CONNECTMAP_MOCK_MODE=true
CONNECTMAP_MOCK_SCENARIO=dynamic
CONNECTMAP_LOG_LEVEL=INFO
CONNECTMAP_DEFAULT_REFRESH_SECONDS=300
CONNECTMAP_REQUEST_TIMEOUT_SECONDS=15
CONNECTMAP_MAX_CONCURRENCY=4
CONNECTMAP_MAX_BODY_BYTES=262144

# Leave empty to persist a generated key in /data/.connectmap-key.
CONNECTMAP_SECRET_KEY=""

# Optional server-side bootstrap. Never commit filled values.
SDEX_VERIFY_TLS=true
SDEX_BASE_URL=""
SDEX_USERNAME=""
SDEX_PASSWORD=""
