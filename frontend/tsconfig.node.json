{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "icon-assets-plugin.ts",
    "icon-assets-plugin.test.ts",
    "e2e/**/*.ts",
    "eslint.config.js"
  ]
}
